+        let steer1 = pipe.observe_hidden(&h1);
+        assert_eq!(steer1, 0.0); // first token has no previous hidden
+
+        let h2 = vec![0.0, 1.0, 0.0];
+        let steer2 = pipe.observe_hidden(&h2);
