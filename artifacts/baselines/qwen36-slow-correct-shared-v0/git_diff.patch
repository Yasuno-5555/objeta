+        }
+    }
+
+    if max_ent > 0.0 { shannon / max_ent } else { 0.0 }
+}
+
+/// 1 - cos(h_curr, h_prev).
+pub fn compute_steering(h_curr: &[f64], h_prev: &[f64]) -> f64 {
+    if h_curr.is_empty() || h_prev.is_empty() {
