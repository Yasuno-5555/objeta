+        assert_eq!(tc2, TokenClass::Stable);
+        assert_eq!(hyst.consecutive_stable, 2);
+
+        // 3rd token stable: remains Stable
+        let tc3 = hyst.classify(0.02, 0.1, false);
+        assert_eq!(tc3, TokenClass::Stable);
+
