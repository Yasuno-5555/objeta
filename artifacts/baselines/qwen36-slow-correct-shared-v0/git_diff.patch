+        let dot_prod = head_curr.iter().zip(head_prev.iter()).map(|(&x, &y)| x * y).sum::<f64>();
+
+        let cos = dot_prod / (norm_curr * norm_prev + 1e-12);
+        divergences.push(1.0 - cos);
+    }
